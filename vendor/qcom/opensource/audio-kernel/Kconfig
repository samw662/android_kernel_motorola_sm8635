menu "Qualcomm external audio modules"
	depends on ARCH_QCOM
	# Pineapple's external audio profile supplies SoundWire and codec modules;
	# CTWO does not enable the in-tree SoundWire controller.

config SND_SOC_PINEAPPLE
	tristate "Qualcomm Pineapple audio machine driver"
	depends on ARCH_PINEAPPLE
	help
	  Build the external Pineapple audio machine module.

