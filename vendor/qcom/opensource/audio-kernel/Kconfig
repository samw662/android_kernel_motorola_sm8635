	tristate "Qualcomm WCD939x external slave codec"
	depends on SND_SOC_WCD939X

config SND_SWR_HAPTICS
	tristate "Qualcomm SoundWire external haptics"

config SND_SOC_MSM_STUB
	tristate "Qualcomm external audio stub codec"

